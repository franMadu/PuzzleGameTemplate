%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd5e33e446cc4bc88bde152074d89f2a, type: 3}
  m_Name: DemoConversation
  m_EditorClassIdentifier:
  background: {fileID: 2800000, guid: 302747fa8bf54d86877b098c197ef86e, type: 3}
  characters:
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
  leftCharacter: {fileID: 21300000, guid: 13b3bf042ff64d6fa84e2e6987739c28, type: 3}
  rightCharacter: {fileID: 21300000, guid: 1b8baf2239c54845991a7db8f309967c, type: 3}
  lines:
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    speaker: Viajera
    speakerSide: 0
    text: Ya estamos en la costa. ¿Quién nos espera junto al faro?
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    speaker: Guía
    speakerSide: 1
    text: Es la mensajera. Quizá traiga noticias del camino que buscamos.
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
    speaker: Mensajera
    text: Os estaba esperando. El paso entre las dunas vuelve a estar abierto.
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    speaker: Viajera
    text: ¿Qué encontraremos al otro lado?
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
    speaker: Mensajera
    text: La última imagen de vuestro viaje. Seguid el sendero cuando estéis preparados.
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    speaker: Guía
    text: Conozco ese sendero. Nos llevará directamente al desierto.
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
    speaker: Mensajera
    text: Entonces volveremos a encontrarnos al final del camino.
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    speaker: Guía
    text: Gracias por avisarnos. Nos pondremos en marcha enseguida.
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    speaker: Viajera
    text: Estoy lista. Esta vez recorreremos el camino juntos.
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
  - speaker:
    speakerSide: 2
    text: Las olas acompañan la despedida mientras el grupo se prepara para continuar el viaje.
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
