MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd5e33e446cc4bc88bde152074d89f2a, type: 3}
  m_Name: ValleyOutro
  m_EditorClassIdentifier:
  background: {fileID: 2800000, guid: 51d1be85345d40f18aa79160e1d881a2, type: 3}
  characters:
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
  lines:
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "¡Ahora lo veo! Aquí decidimos llegar hasta el mar antes de que acabara el verano."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    text: "Y una amiga se adelantó para preparar la siguiente parte del viaje."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "La mensajera. La recuerdo riéndose de lo mucho que pesaba mi cuaderno."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    text: "Nos espera en el faro. El camino de la costa empieza justo ahí."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "Vamos. Quiero saber qué más dejamos escrito."
