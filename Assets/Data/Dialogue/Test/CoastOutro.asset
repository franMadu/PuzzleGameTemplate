  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd5e33e446cc4bc88bde152074d89f2a, type: 3}
  m_Name: CoastOutro
  m_EditorClassIdentifier:
  background: {fileID: 2800000, guid: 302747fa8bf54d86877b098c197ef86e, type: 3}
  characters:
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
  lines:
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "El sol era nuestra señal. Prometimos ver amanecer juntos al otro lado de las dunas."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    text: "Ya has encontrado el destino del tercer dibujo."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
    text: "Me adelantaré hasta el campamento. Allí guardo la última página del cuaderno."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "Esta vez no tendrás que esperarnos tanto."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
    text: "Os guardaré un sitio. Seguid el sendero que sale de la costa."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    text: "Vamos. Aún tenemos un amanecer pendiente."
