--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd5e33e446cc4bc88bde152074d89f2a, type: 3}
  m_Name: DesertOutro
  m_EditorClassIdentifier:
  background: {fileID: 2800000, guid: de6c02fbb9dd472da38c8fa3e4102b7e, type: 3}
  characters:
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
  lines:
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "El valle donde empezamos, la luz que nos guio y las dunas donde prometimos volver... Todo encaja."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    text: "Has reconstruido las tres imágenes."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
    text: "Y hemos cumplido la promesa. Los tres juntos, en el mismo lugar."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "Creía que necesitaba recuperar cada recuerdo para llegar hasta aquí."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    text: "¿Y ahora?"
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "Ahora sé que también podemos crear otros nuevos."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
    text: "Entonces guarda un poco de espacio en ese cuaderno."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "Lo guardaré. El próximo viaje lo empezamos juntos."
