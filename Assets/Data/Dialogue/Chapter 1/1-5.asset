  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd5e33e446cc4bc88bde152074d89f2a, type: 3}
  m_Name: 1-5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  background: {fileID: 2800000, guid: 0630d303da254be39d97147a07bec096, type: 3}
  music: {fileID: 0}
  characters:
  - {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
  - {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
  enterOnFirstSpeech: 0
  initialOutfits:
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit: 
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: baloncesto
  initialExpressions:
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    expression: simpatica
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    expression: inseguridad
  leftCharacter: {fileID: 0}
  rightCharacter: {fileID: 0}
  leftCharacterFacing: 0
  rightCharacterFacing: 0
  lines:
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "Este es tu cuarto. ¿Qué te parece?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: ilusion_contenida
    reactions: []
    speaker:
    text: "Guau. Me encanta. Es más grande que el mío. Y hasta tiene mucha más luz."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: neutra_feliz
    reactions: []
    speaker:
    text: "¿En serio? Me alegra que te guste."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: disculpa
    reactions: []
    speaker:
    text: "Esto... Shouta..."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: sorpresa_contenida
    reactions: []
    speaker:
    text: "¿Qué ocurre, prima?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "Después de instalarte, ¿te gustaría hacer algo?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: inseguridad
    reactions: []
    speaker:
    text: "(¿Quiere hacer algo conmigo? ¿Y qué podemos hacer ella y yo? Si lo único que hago últimamente es quedarme en casa jugando a videojuegos.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: somnoliento_confuso
    reactions: []
    speaker:
    text: "Es que… esta noche no he dormido mucho. Me he quedado hasta tarde jugando al videojuego. ¿Podría echar una siesta?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: neutra_feliz
    reactions: []
    speaker:
    text: "Sí, claro, sin problema. Las sábanas las tienes en el armario, ¿te las apañas solo? "
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: default
    reactions: []
    speaker:
    text: "Sí, no hay problema."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "Estupendo. Yo aún tengo que seguir limpiando la planta baja. ¿Te parece si te aviso para cenar?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: inseguridad
    reactions: []
    speaker:
    text: "Sí, claro. Gracias, prima."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: neutra_feliz
    reactions: []
    speaker:
    text: "Bien, te dejo entonces que te instales."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "Una cosa más, Shouta."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: sorpresa_contenida
    reactions: []
    speaker:
    text: "Dime."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "Prima es demasiado impersonal. Llámame Ayame. ¿De acuerdo?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: muy_avergonzado
    reactions: []
    speaker:
    text: "Sí, prim... Digo, Ay... Aya..."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: muy_avergonzado
    reactions: []
    speaker:
    text: "¡¡AYAME!!"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: felicidad
    reactions: []
    speaker:
    text: "Ja, ja. Qué gracioso. Descansa, Shouta."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: muy_avergonzado
    reactions: []
    speaker:
    text: "(Ayame desaparece tras la puerta del dormitorio. ¿Por qué me ha costado tanto decir su nombre en voz alta?)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: muy_avergonzado
    reactions: []
    speaker:
    text: "(No sé qué debe pensar de mí. Me he estado comportando de forma muy rara desde que he llegado. Qué vergüenza.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: default
    reactions: []
    speaker:
    text: "(Dejo mi maleta a un lado. Y examino la habitación con más detalle.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: ilusion_contenida
    reactions: []
    speaker:
    text: "(Hay una ventana enorme desde la que se ve el mar. No me extraña que sea tan luminosa.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: muy_avergonzado
    reactions: []
    speaker:
    text: "(La abro con la esperanza de que entre un poco de brisa. No sé qué me ocurre. Estoy acalorado y tenso. Miro por encima del hombro constantemente por si Ayame decide aparecer de nuevo.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: inseguridad
    reactions: []
    speaker:
    text: "(Aspiro una bocanada de aire para tranquilizarme.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: protesta_leve
    reactions: []
    speaker:
    text: "Arg. Maldita sea."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: muy_avergonzado
    reactions: []
    speaker:
    text: "(Es lo peor que podría haber hecho. La habitación huele al limpiasuelos. Ha tenido que limpiarla hace poco. Inconscientemente me acuerdo de Ayame y la imagen de su cuerpo a través de la camiseta mojada me viene a la mente.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: protesta_leve
    reactions: []
    speaker:
    text: "Espabila, Shouta. Tengo que hacer algo para dejar de pensar en ella."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: preocupacion
    reactions: []
    speaker:
    text: "Entre el calor y lo nervioso que estoy ahora no creo que pueda dormir, por muy cansado que esté."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: ilusion_contenida
    reactions: []
    speaker:
    text: "Ya sé. Entrenaré un rato. Todavía tengo que probar cómo han balanceado a los personajes en el último parche."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: default
    reactions: []
    speaker:
    text: "(Enciendo la consola y me pongo a jugar.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: default
    reactions: []
    speaker:
    text: "(Durante un rato consigo olvidarme de todo y centrarme en el juego.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: somnoliento_confuso
    reactions: []
    speaker:
    text: "(Aunque poco a poco me noto más espeso. No soy capaz de realizar ningún combo, aunque estoy peleando contra la máquina, pierdo sin remedio.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: decepcion
    reactions: []
    speaker:
    text: "(Una vez, y otra vez, y otra vez, y otra.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: protesta_leve
    reactions: []
    speaker:
    text: "(Tras diez partidas arrojo la consola contra la cama.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: somnoliento_confuso
    reactions: []
    speaker:
    text: "Voy a intentar dormir un rato. El olor a limpiasuelos ya se ha disipado un poco y fuera empieza a refrescar. "
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 1
    hideRightCharacter: 0
