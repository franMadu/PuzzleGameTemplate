  lines:
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: Bienvenido, sientete como en casa.
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Ojal\xE1..."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "\xBFUm? \xBFHas dicho algo?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: No, esto...
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: Creo... Si recuerdo esta casa. No ha cambiado mucho.
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "A la abuela le gusta tal y como est\xE1. Aunque siendo sinceros la he
      modernizado un poco. Hace unos meses que la convenc\xED para que tirara un
      VHS y se comprara una televis\xF3n oled."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: Cosa de abuelas imagino.
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Aqu\xED a la derecha tienes el sal\xF3n. Al fondo est\xE1 la lavabo y
      el ba\xF1o. Arriba est\xE1n las habitaciones. Ven te ense\xF1ar\xE9 la tuya."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: Te sigo.
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: (Cojo en peso mi maleta y empiezo a subir las estrechas escaleras.)
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "(Pienso en lo largas que se me van a hacer estas dos semanas. Ayame no
      parece la t\xEDpica chica que le gusten los videojuegos y hace a\xF1o que no
      nos vemos. No s\xE9 de que hablar con ella sin que acabemos hablando de sus
      padres.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: (Estoy tan absorto en mis pensamientos que no me doy cuenta en lo rapido
      que subo las escaleras. Cuando miro hacia arriba lo tengo justo en mis narices.)
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
