%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd5e33e446cc4bc88bde152074d89f2a, type: 3}
  m_Name: 1-1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  background: {fileID: 2800000, guid: 23d77d00ca384895ba1665cba852b7c2, type: 3}
  music: {fileID: 0}
  characters:
  - {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
  - {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
  enterOnFirstSpeech: 1
  initialOutfits:
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: baloncesto
  initialExpressions:
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    expression: bostezando
  leftCharacter: {fileID: 0}
  rightCharacter: {fileID: 0}
  leftCharacterFacing: 0
  rightCharacterFacing: 0
  lines:
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "¿Shouta?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: bostezando
    reactions: []
    speaker: 
    text: "Mmmmmmm…"
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Shouta, despierta. Casi hemos llegado."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: somnoliento_confuso
    reactions: []
    speaker: 
    text: "(Abro los ojos y el sol de la tarde me deslumbra. Tardo un momento en recordar dónde estoy. En el coche familiar, para mi desgracia. ¿Cuándo me he quedado dormido? Ha debido de ser culpa del traqueteo del coche y de este calor.)"
    isThought: 1
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: bostezando
    reactions: []
    speaker: 
    text: "Ugh, ¿qué pasa? ¿Hemos llegado ya?"
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Ya queda poco, mira qué pintas tienes. Anda, péinate un poco. No querrás presentarte así ante tu abuela."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: desperezandose
    reactions: []
    speaker: 
    text: "(Con desgana, me sacudo el pelo y me limpio un hilillo de saliva que me cuelga de la barbilla.)"
    isThought: 1
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: protesta_leve
    reactions: []
    speaker: 
    text: "¿Por qué?"
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Ya conoces a la abuela, no le gusta que la gente vaya desaliñada."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: protesta_leve
    reactions: []
    speaker: 
    text: "No es eso. Quiero decir que por qué tengo que irme a vivir con la abuela. Podría quedarme en casa, soy mayor y puedo cuidarme solo."
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Tu madre no podría disfrutar del viaje sabiendo que estás solo en casa."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: protesta_leve
    reactions: []
    speaker: 
    text: "¿Por qué? Ya estoy acostumbrado a quedarme solo en casa cuando os vais de viaje de trabajo."
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Hijo, esos viajes duran uno o dos días. Este dura dos semanas."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: decepcion
    reactions: []
    speaker: 
    text: "¿Y no podría ir con vosotros?"
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Ya te lo hemos explicado... es nuestro aniversario. Tu madre y yo llevamos unos meses muy duros en el trabajo y nos apetece tener algo de tiempo para nosotros. Cuando seas mayor lo entenderás."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: ironia
    reactions: []
    speaker: 
    text: "(Ya no soy un niño; sé perfectamente a lo que te refieres...)"
    isThought: 1
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: aburrimiento
    reactions: []
    speaker: 
    text: "(Soltando un sonoro bufido vuelvo la cabeza hacia la ventanilla. Al otro lado hay un bosque tan frondoso que no puedo ver a partir de la segunda línea de árboles.)"
    isThought: 1
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: aburrimiento
    reactions: []
    speaker: 
    text: "(Suelto otro quejido y me acerco a la ventanilla del otro lado. La vista es mucho mejor, un amplio desfiladero con pequeñas casas de verano, de uno o dos pisos. Y al fondo del todo está el mar. No se parece en nada a Tokio.)"
    isThought: 1
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Ya queda poco."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: protesta_leve
    reactions: []
    speaker: 
    text: "Eso ya lo has dicho."
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: aburrimiento
    reactions: []
    speaker: 
    text: "(El silencio en el coche se va volviendo más incómodo. Mi padre y yo nos miramos a través del espejo retrovisor. Intento que mi cara refleje sin lugar a dudas mi enfado.)"
    isThought: 1
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Tómatelo como unas vacaciones."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: ironia
    reactions: []
    speaker: 
    text: "Dos semanas solo, cuidando de una señora de más de cien años... Menudas vacaciones."
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Tu abuela no llega a los ochenta años. No seas maleducado."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: resignacion
    reactions: []
    speaker: 
    text: "Está bien, perdona."
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Además, antes te encantaba pasar aquí las vacaciones."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: aburrimiento
    reactions: []
    speaker: 
    text: "(Eso fue hace mucho tiempo, cuando era un crío.)"
    isThought: 1
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions:
    - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
      expression: sorpresa_contenida
    speaker: 
    text: "Y no vas a estar solo, tu prima también estará allí."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: sorpresa_contenida
    reactions: []
    speaker: 
    text: "Espera, ¿prima? ¿Qué prima?"
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Tu prima Ayame. ¿No te acuerdas de ella? Pasabais los veranos juntos."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: sorpresa_contenida
    reactions: []
    speaker: 
    text: "¿Ayame? ¿Aquella chica bajita era mi prima?"
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "¿Quién pensabas que era?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: default
    reactions: []
    speaker: 
    text: "No sé, la hija de algún vecino de por aquí."
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Es la hija de tu tía Sadako."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: default
    reactions: []
    speaker: 
    text: "Pero la tía no había…"
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Sí."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: aburrimiento
    reactions: []
    speaker: 
    text: "(Se vuelve a hacer un silencio incómodo. Parece como si mi padre se estuviera pensando muy bien qué decir a continuación.)"
    isThought: 1
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "En el accidente de coche del año pasado. Ella y su marido. Ayame vive con la abuela desde entonces."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: default
    reactions: []
    speaker: 
    text: "Ya veo."
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: inseguridad
    reactions: []
    speaker: 
    text: "(Un pequeño escalofrío me recorre la espalda. Vuelvo a mirar hacia la playa.)"
    isThought: 1
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions:
    - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
      expression: aburrimiento
    speaker: 
    text: "Procura no sacar el tema. A ellas les afectó mucho y aún está reciente."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: aburrimiento
    reactions: []
    speaker: 
    text: "Está bien, no diré nada."
    isThought: 0
    speakerSide: 1
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
