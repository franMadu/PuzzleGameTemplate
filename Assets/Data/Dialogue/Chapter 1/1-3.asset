  - {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
  - {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
  enterOnFirstSpeech: 0
  initialOutfits:
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: baloncesto
  initialExpressions:
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    expression: disculpa
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    expression: estupor
  leftCharacter: {fileID: 0}
  rightCharacter: {fileID: 0}
  leftCharacterFacing: 0
  rightCharacterFacing: 0
  lines:
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: estupor
    reactions: []
    speaker:
    text: "(Papá ayuda a la chica a levantarse. Ambos se disculpan efusivamente. Está empapada de arriba abajo y todavía parece aturdida por el golpe.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit:
    expression: 
    reactions: []
    speaker:
    text: "Perdona, Ayame, no te había visto. ¿Estás bien? ¿Te has hecho daño?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: disculpa
    reactions: []
    speaker:
    text: "No se preocupe, la culpa ha sido mía. Iba distraída."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: desconcierto
    reactions: []
    speaker:
    text: "Esto... usted... es..."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: sorpresa
    reactions: []
    speaker:
    text: "¡¿Tío?! ¡¿Shouta?! ¡¿Qué hacéis aquí?!"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit:
    expression: 
    reactions: []
    speaker:
    text: "¿Cómo dices? ¿No te ha contado nada tu abuela? Shouta se queda con vosotras dos semanas."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: desconcierto
    reactions: []
    speaker:
    text: "Pero... pero... ¿no era el mes que viene?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit:
    expression: 
    reactions: []
    speaker:
    text: "No, le dije a tu abuela que era la primera semana de julio."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: sorpresa
    reactions: []
    speaker:
    text: "¡No puede ser! Ella entendió que era la primera semana de agosto."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: ironia
    reactions: []
    speaker:
    text: "(Para ser una señora que no llega a los ochenta años, es bastante despistada.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit:
    expression: 
    reactions: []
    speaker:
    text: "Vaya, menudo lío. Bueno, voy a hablar con ella y se lo voy a explicar. Espero que a vuestra abuela no le importe."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: disculpa
    reactions: []
    speaker:
    text: "Es que... ella... no está aquí."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit:
    expression: 
    reactions: []
    speaker:
    text: "La podemos esperar, no tengo prisa."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: seria
    reactions: []
    speaker:
    text: "No va a volver hoy. Está en un crucero con sus amigas; no volverá hasta el mes que viene."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: ilusion_contenida
    reactions: []
    speaker:
    text: "(Espera... ¿eso significa que me vuelvo a casa? Me gusta cómo está yendo esto.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit:
    expression: 
    reactions: []
    speaker:
    text: "Esto es increíble... ¿Qué hago contigo ahora, Shouta?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: ironia
    reactions: []
    speaker:
    text: "Qué pena, papá, parece que no te queda más remedio que…"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: seguridad
    reactions:
    - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
      expression: alarma
    speaker:
    text: "¡Yo podría cuidarlo!"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: sorpresa_contenida
    reactions: []
    speaker:
    text: "¿Qué?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit:
    expression: 
    reactions: []
    speaker:
    text: "¿Tú? No sé, Ayame. Sin vuestra abuela al cargo sería un poco arriesgado. ¿Y si os ocurre algo?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: seguridad
    reactions: []
    speaker:
    text: "Tranquilo, tío. He estado cuidando a la abuela todo este tiempo. Soy responsable, puedo cuidar de Shouta yo sola."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: protesta_leve
    reactions: []
    speaker:
    text: "(¿Qué dices? Cállate. Aún podría convencer a papá de que me lleve de vuelta a casa.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: seguridad
    reactions: []
    speaker:
    text: "Además, sin la abuela creo que lo podría cuidar mejor. Últimamente está más despistada de lo normal."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "Si quieres quedarte más tranquilo, llámala al móvil; siempre lo lleva encima. Seguro que no tiene ningún inconveniente."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit:
    expression: 
    reactions:
    - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
      expression: decepcion
    speaker:
    text: "Está bien. Quedaos aquí los dos. Voy a hablar con tu madre y con tu abuela."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: decepcion
    reactions: []
    speaker:
    text: "(Maldición, esto va mal. Espero que mamá diga que no.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "Esto... hola, Shouta. Soy Ayame, ¿me recuerdas?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: resignacion
    reactions: []
    speaker:
    text: "No mucho, la verdad."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: neutra_feliz
    reactions: []
    speaker:
    text: "No me extraña. Han pasado casi seis años. Yo… he cambiado mucho. Eras más pequeño que yo, pero ya me sacabas altura."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: default
    reactions: []
    speaker:
    text: "Sí, me acuerdo. Siempre pensé que yo era mayor."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: neutra_feliz
    reactions: []
    speaker:
    text: "Tú también has crecido un poco."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: decepcion
    reactions: []
    speaker:
    text: "Aunque digas eso... soy el más bajito de mi clase. Creo que no voy a crecer mucho más."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "Seguro que en un par de años pegas el estirón y te vuelves el más alto."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: inseguridad
    reactions: []
    speaker:
    text: "(La miro brevemente, tiene una sonrisa amable e inocente. Parece que no ha roto un plato en su vida. Mi mirada vuelve a bajar a la camiseta mojada y la aparto enseguida.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: desconcierto
    reactions: []
    speaker:
    text: "¿Pasa algo? No serás tímido."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: inseguridad
    reactions: []
    speaker:
    text: "(La vuelvo a mirar. Ahora su cara refleja extrañeza. ¿Pensará que soy raro?)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: inseguridad
    reactions: []
    speaker:
    text: "O… oye. Estás empapada, ¿no tendrías que secarte o algo? ¿Necesitas una toalla?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "Solo es un poco de agua sucia, no te preocupes. Además, con este calor no se está tan mal."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: default
    reactions: []
    speaker:
    text: "¿Siempre hace tanto calor aquí?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: neutra_feliz
    reactions: []
    speaker:
    text: "Justo esta semana hemos tenido una ola de calor. Esta noche también será calurosa, pero a partir de mañana la temperatura será más suave."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: default
    reactions: []
    speaker:
    text: "…"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "¿No me cuentas nada de ti? ¿Cómo te han ido las cosas?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: default
    reactions: []
    speaker:
    text: "Bien, sin nada especial que contar. ¿Y a ti?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: seria
    reactions: []
    speaker:
    text: "¿A mí? Bueno, verás…"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: alarma
    reactions: []
    speaker:
    text: "(Mierda, me había olvidado de lo de sus padres.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: ilusion_contenida
    reactions: []
    speaker:
    text: "Bueno, espera, sí que hay algo. ¿Sabías que soy subcampeón regional de Super Smash Brawlers?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: felicidad
    reactions: []
    speaker:
    text: "¿De verdad? Shouta, eso es genial."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: ilusion_contenida
    reactions: []
    speaker:
    text: "¿A que sí? No lo suelo ir contando por ahí pero…"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: sorpresa_contenida
    reactions: []
    speaker:
    text: "Espera, ¿en serio es genial? Cuando lo cuento la gente me mira raro."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 2cc228ba2da24648935c80e69a2da2ad, type: 2}
    outfit:
    expression: simpatica
    reactions: []
    speaker:
    text: "Lo digo muy en serio, eres increíble."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit:
    expression: inseguridad
