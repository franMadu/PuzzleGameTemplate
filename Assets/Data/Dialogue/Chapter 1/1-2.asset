  leftCharacterFacing: 0
  rightCharacterFacing: 0
  lines:
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: resignacion
    reactions: []
    speaker: Shouta
    text: "(El coche se detiene frente a una pequeña casa rural, junto a un bosque. Entre los árboles puedo ver la playa. Me quedo en el coche mirando la casa. Sí, es la casa de la abuela. No ha cambiado nada en estos años.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "Shouta, sal del coche y ven a saludar, rápido."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: ironia
    reactions: []
    speaker: 
    text: "(Lentamente abro la puerta y salgo del coche. Intento retrasar todo lo posible este momento. Intento que dure, no sé, unas dos semanas.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions: []
    speaker: 
    text: "¡Qué raro! No hay nadie para recibirnos. Ven, vamos a mirar en la parte de atrás."
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: sorpresa_contenida
    reactions: []
    speaker: 
    text: "(Al doblar la esquina de la casa, una chica aparece con un cubo de agua en la mano.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: alarma
    reactions: []
    speaker: 
    text: "(Choca de frente con mi padre y suelta un grito. Intenta recuperar el equilibrio, pero el cubo se le vuelca encima. Un instante después, está en el suelo.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 05f84f0548cb501478830ab5786d51f5, type: 2}
    outfit: 
    expression: 
    reactions:
    - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
      expression: estupor
    speaker: 
    text: "Ayame, ¿eres tú? ¿Estás bien?"
    isThought: 0
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
  - character: {fileID: 11400000, guid: 1665d2ed1296b4d4598f2f6b08458726, type: 2}
    outfit: 
    expression: estupor
    reactions: []
    speaker: 
    text: "(Papá corre a ayudar a la chica que está en el suelo. Yo me quedo congelado; lo único que puedo hacer es contemplar la escena que tengo ante mis ojos.)"
    isThought: 1
    speakerSide: 0
    leftCharacter: {fileID: 0}
    rightCharacter: {fileID: 0}
    hideLeftCharacter: 0
    hideRightCharacter: 0
