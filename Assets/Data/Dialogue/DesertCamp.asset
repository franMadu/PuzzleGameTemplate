%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd5e33e446cc4bc88bde152074d89f2a, type: 3}
  m_Name: DesertCamp
  m_EditorClassIdentifier:
  background: {fileID: 2800000, guid: de6c02fbb9dd472da38c8fa3e4102b7e, type: 3}
  characters:
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
  lines:
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "Pensaba que llegaríamos antes. Se me había olvidado lo largo que era este camino."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    text: "Todavía estamos a tiempo. El mirador está después de aquellas dunas."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
    text: "Y aquí está la última página. La dejaste conmigo para que no se perdiera."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "Está en blanco por detrás... Solo dice que los recuerdos no tienen que llevarse a solas."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
    text: "Lo escribiste cuando decidimos volver a hacer este viaje algún día."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    text: "Nos preocupaba que quisieras recorrerlo sin ayuda."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "Ahora entiendo por qué vinisteis. No intentabais mostrarme un destino, sino acompañarme."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be13, type: 2}
    text: "Y aún nos queda la mejor vista. Venid, os enseñaré el último tramo."
