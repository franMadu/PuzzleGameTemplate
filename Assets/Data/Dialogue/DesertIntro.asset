  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd5e33e446cc4bc88bde152074d89f2a, type: 3}
  m_Name: DesertIntro
  m_EditorClassIdentifier:
  background: {fileID: 2800000, guid: de6c02fbb9dd472da38c8fa3e4102b7e, type: 3}
  characters:
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
  - {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
  lines:
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "Las dunas han cambiado desde la última vez. Sin el dibujo no reconocería este lugar."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    text: "La arena se mueve, pero las montañas del fondo siguen señalando el camino."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be11, type: 2}
    text: "Veo el campamento. Hay alguien junto a las provisiones."
  - character: {fileID: 11400000, guid: b2171898fbca4a7b9088ddca98e9be12, type: 2}
    text: "Es nuestra amiga. Descansemos antes de ir al mirador."
